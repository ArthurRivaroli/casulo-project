// Casulo — schema Prisma
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  BANK
  CASH
  CREDIT_CARD
}

enum EntryType {
  INCOME
  EXPENSE
}

model Household {
  id           String        @id @default(cuid())
  name         String
  users        User[]
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  goals        Goal[]
  createdAt    DateTime      @default(now())
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  household    Household     @relation(fields: [householdId], references: [id])
  householdId  String
  transactions Transaction[]
  createdAt    DateTime      @default(now())
}

model Account {
  id           String        @id @default(cuid())
  name         String // ex: "Conta à Ordem", "Cartão Crédito"
  type         AccountType
  household    Household     @relation(fields: [householdId], references: [id])
  householdId  String
  transactions Transaction[]
}

model Category {
  id          String        @id @default(cuid())
  name        String
  type        EntryType
  color       String?
  household   Household     @relation(fields: [householdId], references: [id])
  householdId String
  transactions Transaction[]
  budgets     Budget[]
}

model Transaction {
  id          String    @id @default(cuid())
  amount      Float
  description String?
  date        DateTime
  type        EntryType
  household   Household @relation(fields: [householdId], references: [id])
  householdId String
  account     Account   @relation(fields: [accountId], references: [id])
  accountId   String
  category    Category  @relation(fields: [categoryId], references: [id])
  categoryId  String
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime  @default(now())

  // Despesa fixa (ex: aluguel) ou compra parcelada (ex: 3/12) — cada
  // ocorrência é uma Transaction independente, ligada às irmãs por
  // recurrenceGroupId só pra fins de exibição/agrupamento.
  isFixed           Boolean @default(false)
  installmentNumber Int?
  installmentTotal  Int?
  recurrenceGroupId String?

  @@index([recurrenceGroupId])
}

model Budget {
  id          String    @id @default(cuid())
  amount      Float
  month       Int
  year        Int
  household   Household @relation(fields: [householdId], references: [id])
  householdId String
  category    Category  @relation(fields: [categoryId], references: [id])
  categoryId  String

  @@unique([householdId, categoryId, month, year])
}

model Goal {
  id            String    @id @default(cuid())
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  deadline      DateTime?
  household     Household @relation(fields: [householdId], references: [id])
  householdId   String
}
